{
  "_help": "Sound effects land on narration cues: 're' is a case-insensitive regex tested against each sentence, 'at' = seconds after the sentence starts, 'shake' = camera knock strength (px). 'beds' loop ambience over scene numbers (inclusive). Check matches with: python scripts/check_sfx_rules.py zs-ep01",
  "rules": [
    {"re": "my phone let out an alarm", "sfx": "alert_tone", "vol": 0.7, "at": 0.0},
    {"re": "messages kept jumping in", "sfx": "notify", "vol": 0.45, "at": 0.4},
    {"re": "Someone asked what was happening", "sfx": "notify", "vol": 0.4, "at": 0.0},
    {"re": "Someone said not to go outside", "sfx": "notify", "vol": 0.4, "at": 0.0},
    {"re": "deleted before I could", "sfx": "phone_buzz", "vol": 0.4, "at": 1.5},
    {"re": "car rear-ended another", "sfx": "crash", "vol": 0.5, "at": 1.1, "shake": 4},
