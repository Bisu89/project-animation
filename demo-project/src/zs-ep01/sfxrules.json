    {"re": "door rattled a few more times", "sfx": "door_rattle", "vol": 0.7, "at": 0.4, "shake": 5},
    {"re": "sound of glass breaking", "sfx": "glass_far", "vol": 0.7, "at": 1.9},
    {"re": "drag of their feet on the concrete", "sfx": "footsteps", "vol": 0.3, "at": 0.0},
    {"re": "new notification appeared", "sfx": "notify", "vol": 0.8, "at": 3.2},
    {"re": "saved the evacuation address", "sfx": "notify", "vol": 0.3, "at": 0.8},
    {"re": "footsteps passed by", "sfx": "footsteps", "vol": 0.45, "at": 0.3},
    {"re": "did I open the door", "sfx": "bolt_slide", "vol": 0.6, "at": 1.6}
